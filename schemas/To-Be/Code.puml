@startuml WarmHouse Code Diagram
title WarmHouse Code Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

class User {
  +String name
  +String email
  +List<House> houses
  +void register()
  +void login()
}

class House {
  +String name
  +List<Device> devices
  +void addHouse()
  +void removeHouse()
}

class DeviceType {
  +Int id
  +String name
  +void addType()
}

class Device {
  +String serialNumber
  +Bool isActive 
  +void addDevice()
  +void removeDevice()
  +void activateDevice()
}

class Schedule {
  +Int hour
  +Int minute
  +Int weekDay
  +Bool isActive
  +void setSchedule()
  +void removeSchedule()
}

class Scenario {
  +Int id
  +String name
  +Bool status
  +List<Device> devices
  +List<Schedule> schedules
  +void addScenario()
  +void removeScenario()
  +void activateScenario()
  +void addDeviceToScenario(Device device)
  +void removeDeviceFromScenario(Device device)
  +void addScheduleToScenario(Schedule schedule)
  +void removeScheduleFromScenario(Schedule schedule)
}

User "1" -- "0..*" House : has
House "1" -- "0..*" Module : has
House "1" -- "0..*" Device : has
Device "*" -- "1" DeviceType : has

Device "1" -- "0..*" Schedule : has
Scenario "*" -- "*" Device : contains
Scenario "1" -- "0..*" Schedule : has

@enduml